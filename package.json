{
  "name": "feresula-coffee",
  "version": "1.0.0",
  "private": true,
  "description": "Feresula Coffee React landing page and Express API",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
